# Midnight Snack Club — every variable here is optional.
# With none of them set the app runs exactly as it always has: no account, no
# sync, no AI, everything in localStorage.

# ---------------------------------------------------------------------------
# Accounts and cross-device sync (optional)
# ---------------------------------------------------------------------------
# From Supabase: Project Settings -> API Keys.
# Both are NEXT_PUBLIC_ on purpose — this key is designed to ship in the browser
# bundle. Row-level security, not secrecy, is what protects user data; see
# supabase/migrations/0001_kitchen_state.sql.
#
# Set the URL plus one key, run that migration, and the sign-in UI appears.
# Leave them unset and it stays hidden.
NEXT_PUBLIC_SUPABASE_URL=

# Prefer the modern publishable key (sb_publishable_...) — it rotates
# independently of the project's JWT secret.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy JWT anon key. Still supported, and what the Vercel Supabase
# integration injects automatically. Used only if the one above is unset.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Recipe invention (optional)
# ---------------------------------------------------------------------------
# Server-side only — never exposed to the browser.
ANTHROPIC_API_KEY=

# Override the model used for invented recipes. Defaults to claude-sonnet-5.
# ANTHROPIC_MODEL=
